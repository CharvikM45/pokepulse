# Optional for A-02. Bootstrap works with no environment file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server only. Never prefix service-role keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
# No retailer credentials are consumed at bootstrap.
APP_ORIGIN=http://localhost:3000
# Workers read these from their process environment, not apps/web/.env.local automatically.
VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
VAPID_PRIVATE_KEY=YOUR_SERVER_ONLY_VAPID_KEY
VAPID_SUBJECT=mailto:YOUR_OPERATIONS_EMAIL
# Public browser push key, matching the worker's VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
# Optional licensed raster map. Leave blank/off until provider permission and
# attribution requirements are reviewed; list-only Radar remains available.
MAP_TILES_APPROVED=false
MAP_TILES_ALLOWED_HOST=
MAP_TILES_URL_TEMPLATE=
MAP_TILES_ATTRIBUTION=
