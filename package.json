{
  "name": "pokepulse",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pokepulse/web dev",
    "build": "pnpm --filter @pokepulse/web build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @pokepulse/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:ingestion": "tsx services/ingestion/run.ts",
    "worker:notifications": "tsx services/notification-worker/run.ts",
    "test:db": "vitest run tests/integration",
    "simulate": "tsx scripts/simulate.ts",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "zod": "4.3.6"
  },
  "type": "module"
}
